# Termbox Runner Configuration
TERMBOX_HOST=0.0.0.0
TERMBOX_PORT=8000
TERMBOX_DEBUG=false
TERMBOX_DB_PATH=termbox_runner.db

# Docker Sandbox Defaults
TERMBOX_DEFAULT_DOCKER_IMAGE=python:3.12-slim
TERMBOX_DEFAULT_TIMEOUT_SECONDS=30.0
TERMBOX_MAX_TIMEOUT_SECONDS=300.0

# Resource Limits
TERMBOX_DEFAULT_MEM_LIMIT=512m
TERMBOX_MAX_MEM_LIMIT=2g
TERMBOX_DEFAULT_CPU_QUOTA=1.0
TERMBOX_MAX_CPU_QUOTA=4.0
TERMBOX_DEFAULT_PIDS_LIMIT=128
TERMBOX_MAX_PIDS_LIMIT=1024

# Security & Sandboxing
TERMBOX_DEFAULT_NETWORK_MODE=none
TERMBOX_ALLOW_NETWORK_OVERRIDE=true

# Execution Engine ("docker" or "mock")
TERMBOX_EXECUTION_MODE=docker
